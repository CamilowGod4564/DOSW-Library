# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ==========================================
POSTGRES_DB=DBLibraryLocal
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_contraseña_segura
POSTGRES_PORT=5432
POSTGRES_INTERNAL_PORT=5432
DB_CONTAINER_NAME=dosw-library-db

# ==========================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ==========================================
APP_NAME=DOSW-Library
APP_PORT=8080
APP_CONTAINER_NAME=dosw-library-app

# ==========================================
# CREDENCIALES SPRING SECURITY
# ==========================================
SECURITY_USERNAME=admin
SECURITY_PASSWORD=cambiar_en_produccion

# ==========================================
# CONFIGURACIÓN JPA
# ==========================================
SHOW_SQL=false
GENERATE_DDL=false
DDL_AUTO=validate  # En producción usar 'validate' o 'none'
JPA_DATABASE=POSTGRESQL
SQL_PLATFORM=postgres

# ==========================================
# CONFIGURACIÓN JWT
# ==========================================
# Genera un secret seguro: openssl rand -base64 32
JWT_SECRET=genera_un_secret_seguro_aqui_minimo_32_caracteres
JWT_EXPIRATION=86400000

# ==========================================
# CONFIGURACIÓN ADICIONAL
# ==========================================
TZ=America/Bogota
JAVA_OPTS=-Xmx512m -Xms256m
VOLUME_NAME=dosw_postgres_data
NETWORK_NAME=dosw-network